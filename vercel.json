{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 server/build.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server,design}/**",
      "excludeFiles": "server/data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!assets/|static/).*)", "destination": "/api/index" }
  ]
}
